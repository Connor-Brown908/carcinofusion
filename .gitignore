# Source data is never committed. It is acquired per the protocol and its
# checksums are recorded in manifests/, which IS committed.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep

# The external directory holds the resolution table and any external
# validation set. Commit those deliberately if licensing allows.
data/external/*
!data/external/.gitkeep

# Per-run manifests are OUTPUTS of a run, not source. Committing them would
# put fixture-run provenance in the repository, where it reads as real.
# Provenance travels with the data instead: DATASET_LOCK.json inside the
# frozen dataset, and the benchmark_runs table in Supabase.
manifests/*.json
!manifests/.gitkeep

__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.DS_Store
*.egg-info/

# Phase 2 artifacts
data/processed/benchmark/
data/processed/supabase/
artifacts/
*.pt
